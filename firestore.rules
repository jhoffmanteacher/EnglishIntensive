rules_version = '2';

/* ══════════════════════════════════════════════════════════════════════
   English Intensive — Firestore security rules

   THESE RULES ARE THE REAL SECURITY BOUNDARY. Everything in the site is
   client-side and therefore bypassable from DevTools: the sign-in wall is
   a div, teacher.html's account check is a div, and the @seq.org check in
   auth.js is a convenience message. Only what is written here actually
   stops anyone.

   This file is the source of truth, but editing it changes NOTHING on its
   own — GitHub Pages does not deploy Firestore rules. Paste the contents
   into Firebase console → Firestore Database → Rules → Publish (or run
   `firebase deploy --only firestore:rules` if the CLI is ever set up).
   Keep this file and the console in sync; if they drift, the console wins
   and this file becomes a lie. tools/rules-test.mjs runs this file
   against the Firestore emulator.

   The site touches these paths (verified against store.js, auth.js and
   teacher.js):
     students/{uid}      one doc per student: words (per-word stats),
                         heard (what the mic returned on a miss), totals,
                         recent rounds, name/email/photo, and the
                         student's `classId` + `teachers`
     assignments/{uid}   teacher-written: assigned list ids, + `classId`
                         and `teachers` (the student reads their own)
     notes/{uid}         teacher-written and TEACHER-READ: the teacher's
                         private note about a student, + `classId`/`teachers`
     roster/{email}      teacher-written: the class list as imported, keyed
                         by the address a student will sign in with, so a
                         student can be placed before they ever appear.
                         Its `classId` is the record of which class the
                         student is in.
     classes/{classId}   a class: { name, teachers: [emails], archived,
                         createdAt, createdBy }. Replaces periods.
     teachers/{email}    who is a teacher on the site. Admin-written.
     config/class        the OLD shared periods doc. Admin-read only, so
                         the dashboard can turn its periods into classes.

   ── Classes, teachers and the admin ───────────────────────────────────
   One admin, named in isAdmin() below and in ADMIN_EMAILS in
   firebase-config.js. The admin reads and writes everything, and is the
   only one who can add or remove a teacher on the SITE (teachers/{email}).

   A CLASS is a named group with one or more teachers; every student is
   in exactly one class. Any teacher on a class may add or remove
   co-teachers on it (the dashboard offers only approved teachers), and a
   class can never be left with no teachers.

   Every document about a student — roster row, students doc, assignment,
   note — carries the student's `classId` and a COPY of that class's
   `teachers` array. The copy is the whole trick: Firestore rules are not
   filters, a list query is allowed only when the rule can be proven from
   the query, and `me() in resource.data.teachers` is provable from
   where('teachers', 'array-contains', me) — which is the where clause on
   every teacher-side list query in teacher.js. The admin's have none.

   A teacher's write must stamp the target class's own teachers array
   (checked with one get() of that class — the same doc for every write
   in a class, which Firestore counts once) and that array must include
   them. An update must also be to a doc that already includes them, is
   unowned legacy, or belongs to a class they teach. When a class's
   co-teachers change, the dashboard rewrites the copy on every member
   doc; until it lands, the dashboard's load-time self-heal finishes it.
   A teacher removed from a class loses access once their address is
   gone from the copies.

   Anything not matched below is denied by default. Do not add a catch-all.
   ══════════════════════════════════════════════════════════════════════ */

service cloud.firestore {
  match /databases/{database}/documents {

    /* Sign-in is restricted to one school domain. Two conditions, both
       load-bearing:

       email_verified — without it, anyone who could register an @seq.org
       address under a provider that doesn't verify (enabling
       Email/Password is a single console toggle with no footprint in this
       repo) would be inside the class. Google sign-in — the only provider
       the site enables — always sets email_verified, so this locks nobody
       real out.

       The domain match is anchored at both ends on purpose:
       "...@seq.org.attacker.com" contains "@seq.org" and an unanchored
       match would wave it through. */
    function isSchool() {
      return request.auth != null
          && request.auth.token.email_verified == true
          && request.auth.token.email.matches('^[^@]+@seq[.]org$');
    }

    // The signed-in address, lowercased. Only ever called after
    // isSchool(), which guarantees a token with an email in it.
    function me() {
      return request.auth.token.email.lower();
    }

    /* The one admin. Keep this and ADMIN_EMAILS in firebase-config.js
       together: the dashboard reads one, the database enforces this. */
    function isAdmin() {
      return isSchool() && me() == 'jhoffman@seq.org';
    }

    /* A teacher: the admin, or anyone the admin has added on the
       dashboard (a teachers/{email} doc). Being a teacher grants nothing
       about any class they aren't on — see the per-collection rules. */
    function isTeacher() {
      return isSchool()
          && (isAdmin() || exists(/databases/$(database)/documents/teachers/$(me())));
    }

    function classTeachers(classId) {
      return get(/databases/$(database)/documents/classes/$(classId)).data.teachers;
    }

    /* A teacher's write of a student doc's class stamp: `teachers` must be
       exactly the named class's own array, and include the writer. */
    function stampOk() {
      return request.resource.data.get('classId', null) is string
          && request.resource.data.get('teachers', null) == classTeachers(request.resource.data.classId)
          && me() in request.resource.data.teachers;
    }
    /* …or, for an update, a rewrite to the SAME class's current array by
       a teacher who was on the doc — how a teacher removes THEMSELVES
       from a class and then rewrites its members. Same class only: it
       must never be a way to move a student somewhere the writer isn't. */
    function restampOk() {
      return request.resource.data.get('classId', null) is string
          && request.resource.data.classId == resource.data.get('classId', null)
          && request.resource.data.get('teachers', null) == classTeachers(request.resource.data.classId)
          && me() in resource.data.get('teachers', []);
    }
    /* May this teacher touch an EXISTING doc? It names them; or it is
       legacy with no owner at all; or it belongs to a class they teach
       (so a half-finished co-teacher rewrite can be finished by anyone on
       the class). The get() is last, so it only runs when needed. */
    function holdsDoc() {
      return me() in resource.data.get('teachers', [])
          || !('teachers' in resource.data)
          || me() in classTeachers(resource.data.classId);
    }

    /* Who is a teacher. Any teacher may read the list — the co-teacher
       picker shows names — and anyone may read their own doc, which is
       how auth.js decides whether to show the dashboard. Only the admin
       may add or remove. */
    match /teachers/{email} {
      allow read: if isTeacher() || (isSchool() && me() == email);
      allow write: if isAdmin();
    }

    /* A class. Read by its teachers (the dashboard lists them with
       where('teachers','array-contains',me)). Created by a teacher who
       puts themselves on it. Updated by any teacher on it — rename, add
       or remove co-teachers, archive a student — never to zero teachers.
       Deleted by a teacher on it; the dashboard only offers that for an
       empty class. */
    match /classes/{classId} {
      allow read: if isAdmin() || (isTeacher() && me() in resource.data.teachers);
      allow create: if (isAdmin() || (isTeacher() && me() in request.resource.data.teachers))
                    && request.resource.data.teachers is list
                    && request.resource.data.teachers.size() > 0;
      allow update: if (isAdmin() || (isTeacher() && me() in resource.data.teachers))
                    && request.resource.data.teachers is list
                    && request.resource.data.teachers.size() > 0;
      allow delete: if isAdmin() || (isTeacher() && me() in resource.data.teachers);
    }

    /* One document per student, keyed by uid.

       A student reads and writes ONLY their own. Their teachers get read
       — deliberately NOT write, beyond the class stamp below. The
       dashboard never needs to modify student work (assignments live in
       their own collection precisely so that it doesn't), and withholding
       write means a compromised teacher session cannot erase a term of
       practice.

       The email condition stops a student writing someone else's address
       onto their own doc. It's written as "if the field is present"
       because store.js sends merge-writes that often carry only the
       changed words.

       The class condition: on a student's own write, `classId` and
       `teachers` must come out unchanged, or equal to their own roster
       row's. That is the only way they change from the student's side,
       and it is how a student reaches the class they were imported into
       (store.js copies them on sign-in). The roster get() only runs when
       they actually change. */
    match /students/{userId} {
      /* Read and write are separate statements on purpose.
         `request.resource` is null on a read, so a single
         `allow read, write` that mentions request.resource.data errors on
         every get — and an error is a deny. */
      allow read: if isSchool() && request.auth.uid == userId;
      allow create, update: if isSchool()
                         && request.auth.uid == userId
                         && (!('email' in request.resource.data)
                             || request.resource.data.email == request.auth.token.email)
                         && ((request.resource.data.get('classId', null)
                                == (resource == null ? null : resource.data.get('classId', null))
                              && request.resource.data.get('teachers', null)
                                == (resource == null ? null : resource.data.get('teachers', null)))
                             || (request.resource.data.get('classId', null)
                                   == get(/databases/$(database)/documents/roster/$(me())).data.get('classId', null)
                                 && request.resource.data.get('teachers', null)
                                   == get(/databases/$(database)/documents/roster/$(me())).data.get('teachers', null)));
      // `in resource.data.teachers`, not .get(): a list query is allowed
      // only when the rule can be proven from its where clause, and this
      // is the form that proof understands for array-contains.
      allow read: if isAdmin() || (isTeacher() && me() in resource.data.teachers);
      /* Moving a student between classes, or rewriting the stamp after a
         co-teacher change: the class fields and nothing else. A teacher
         must hold the doc now and stamp a class they're on (or be
         rewriting to the class's current array); the admin, anything. */
      allow update: if isTeacher()
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['classId', 'teachers'])
                    && (isAdmin() || (holdsDoc() && (stampOk() || restampOk())));
    }

    /* Which lists a student has been assigned. Teacher writes; the
       student reads their own row and nobody else's — a student has no
       business knowing what another student has been put on.

       A teacher may get one that names them, or one that doesn't exist
       (which tells nobody anything); a list must carry the where clause.
       A create needs a valid stamp. An update also needs the existing doc
       to be the teacher's (holdsDoc) — or, failing that, the student's
       own doc to name them: the case of a student who has just arrived
       in their class from somewhere they can't see. */
    match /assignments/{userId} {
      allow read:   if isSchool() && request.auth.uid == userId;
      allow get:    if isAdmin()
                    || (isTeacher() && (resource == null || me() in resource.data.get('teachers', [])));
      allow list:   if isAdmin() || (isTeacher() && me() in resource.data.teachers);
      allow create: if isAdmin() || (isTeacher() && stampOk());
      allow update: if isAdmin()
                    || (isTeacher()
                        && (stampOk() || restampOk())
                        && (holdsDoc()
                            || me() in get(/databases/$(database)/documents/students/$(userId)).data.get('teachers', [])));
      allow delete: if isAdmin() || (isTeacher() && me() in resource.data.get('teachers', []));
    }

    /* The teacher's private note about a student — "reads well, freezes
       when timed".

       This is the ONE path a student may not read about themselves, and
       that is the entire reason it is its own collection rather than a
       field on assignments/{uid}: a student can read their own assignment
       row, so a note stored there would be a note its subject can read.
       So: the student's teachers (and the admin) only, no student-read
       clause. Ownership is checked exactly as for assignments. A note is
       shared by the class's co-teachers. */
    match /notes/{userId} {
      allow get:    if isAdmin()
                    || (isTeacher() && (resource == null || me() in resource.data.get('teachers', [])));
      allow list:   if isAdmin() || (isTeacher() && me() in resource.data.teachers);
      allow create: if isAdmin() || (isTeacher() && stampOk());
      allow update: if isAdmin()
                    || (isTeacher()
                        && (stampOk() || restampOk())
                        && (holdsDoc()
                            || me() in get(/databases/$(database)/documents/students/$(userId)).data.get('teachers', [])));
      allow delete: if isAdmin() || (isTeacher() && me() in resource.data.get('teachers', []));
    }

    /* The imported class roster, one document per student, keyed by the
       address they will sign in with — `<student id>@seq.org`.

       Keyed by EMAIL rather than by uid because the whole point is to
       exist before the student does. The email derived from the ID
       number is the only thing knowable on both sides of a first sign-in,
       which makes it the only possible join.

       A student may read exactly one document: their own (their class
       and any lists set up before they had an account resolve through
       it). They may not WRITE it: the row decides which lists they get and
       which class they are in.

       A teacher may get a row that names them, a row with no owner yet
       (legacy — theirs to claim), and a row that doesn't exist. Getting a
       row in a class they don't teach is refused, and that refusal is
       exactly how the import learns a student is already in another
       class: it skips them and says so. get and list are separate on
       purpose: the unowned clause can't be proven from a where clause,
       and under a combined `read` the emulator let an unfiltered list of
       EVERY row through.

       `.lower()` on the token, not on the id: the document id is written
       lowercased by the import. */
    match /roster/{email} {
      allow read:   if isSchool() && me() == email;
      allow get:    if isAdmin()
                    || (isTeacher() && (resource == null
                                        || !('teachers' in resource.data)
                                        || me() in resource.data.teachers));
      allow list:   if isAdmin() || (isTeacher() && me() in resource.data.teachers);
      allow create: if isAdmin() || (isTeacher() && stampOk());
      allow update: if isAdmin()
                    || (isTeacher() && (stampOk() || restampOk()) && holdsDoc());
      allow delete: if isAdmin() || (isTeacher() && me() in resource.data.get('teachers', []));
    }

    /* The old shared periods doc, from before classes. The admin's
       dashboard reads it once, to turn its periods into classes; nothing
       writes it any more. Scoped to the one doc — config/{doc} would
       cover every future document under config/. */
    match /config/class {
      allow read: if isAdmin();
    }
  }
}
